{
  "name": "mpeg2toh264-web",
  "version": "0.0.1",
  "description": "Browser MSE player for the mpeg2toh264 transcoder",
  "type": "module",
  "private": true,
  "scripts": {
    "web:dev": "vite web",
    "web:build": "vite build web --outDir ../dist --emptyOutDir",
    "typecheck": "tsc --noEmit -p web && tsc --noEmit -p web/tsconfig.worker.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  }
}
