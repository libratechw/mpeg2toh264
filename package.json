{
  "name": "mpeg2toh264-workspace",
  "version": "0.0.1",
  "description": "Browser packages for the mpeg2toh264 transcoder",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace @mpeg2toh264/demo",
    "web:build": "npm run build --workspace @mpeg2toh264/demo",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  }
}
