{
  "name": "mpeg2toh264",
  "version": "0.0.1",
  "description": "MPEG-2 to H.264 bitstream-domain transcoder (no IDCT, no motion compensation)",
  "type": "module",
  "bin": {
    "mpeg2toh264": "tools/mpeg2toh264.ts"
  },
  "scripts": {
    "transcode": "node --experimental-strip-types tools/mpeg2toh264.ts",
    "web:dev": "vite web",
    "web:build": "vite build web --outDir ../dist --emptyOutDir",
    "test": "vitest run",
    "watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p web/tsconfig.worker.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
