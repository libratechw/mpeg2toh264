{
  // The worker needs lib.webworker, which redeclares self, postMessage and
  // much else that lib.dom also declares, so it cannot share a program with
  // the page's sources.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"]
  },
  "include": [
    "src/worker.ts",
    "src/transcoder.ts",
    "src/source.ts",
    "src/mse.ts",
    "src/protocol.ts",
    // What lib.webworker leaves out of Media Source Extensions. See the file.
    "src/worker-mse.d.ts"
  ]
}
