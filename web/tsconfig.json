{
  // The options the TypeScript implementation kept in a root tsconfig, which
  // went away with it. web/ is the only TypeScript left, so they live here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // Only what the sources import: an ambient @types package would otherwise
    // put Node's globals into a program that has none of them.
    "types": []
  },
  // Listed one by one rather than by glob: src/ holds both halves, and the
  // worker's ambient MSE declarations would collide with lib.dom here.
  "include": [
    "demo.ts",
    "src/index.ts",
    "src/player.ts",
    "src/mse.ts",
    "src/protocol.ts",
    "src/deinterlace.ts",
    "src/probe.ts",
    "src/yadif/shader.ts"
  ]
}
