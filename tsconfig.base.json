{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "paths": {
      "@mpeg2toh264/player": ["./packages/player/src/index.ts"],
      "@mpeg2toh264/yadif": ["./packages/yadif/src/index.ts"]
    }
  }
}
